{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cliy",
  "compatibility_date": "2025-02-14",
  "assets": {
    "directory": "./out"
  },
  "routes": [
    {
      "pattern": "cliy.me",
      "custom_domain": true
    },
    {
      "pattern": "www.cliy.me",
      "custom_domain": true
    }
  ]
}
